{
  "schema_version": "1.0",
  "canonical_registry": "https://github.com/vLLM-HUST/vllm-hust-docs/tree/codex/ecosystem-architecture-reorganization/registry",
  "repository": "https://github.com/vLLM-HUST/LMCache-Ascend",
  "repository_role": "integration_provider",
  "relation_to_runtime": "integrates_external_system",
  "lifecycle": "incubating",
  "artifacts": [
    {
      "id": "lmcache-ascend-provider",
      "artifact_type": "runtime_component",
      "system_role": "platform_backend",
      "delivery_model": "python_distribution",
      "execution_planes": ["worker", "native", "device"],
      "integration_contracts": [],
      "integration_surfaces": ["lmcache.storage_backend"]
    },
    {
      "id": "lmcache-ascend-vllm-adapter",
      "artifact_type": "bridge",
      "system_role": "kv_integration",
      "delivery_model": "python_distribution",
      "execution_planes": ["api", "scheduler", "worker"],
      "integration_contracts": [
        "vllm.kv_connector.scheduler.v1",
        "vllm.kv_connector.worker.v1",
        "vllm.kv_connector.telemetry.v1"
      ]
    }
  ],
  "system_boundaries": {
    "is": [
      "an Ascend data movement provider for LMCache",
      "a distribution of framework-specific LMCache adapters",
      "a Bundle v1 distribution with split scheduler, worker, and API telemetry roles"
    ],
    "is_not": [
      "the LMCache multi-tier KV state manager or Controller",
      "a vLLM runtime-core module",
      "a standalone cluster control plane"
    ]
  },
  "validation": [
    "ruff check .",
    "python3 -u -m pytest -v tests/v1",
    "run .github/workflows/perf-and-accuracy.yml on supported Ascend hardware"
  ],
  "compatibility_document": "README.md#compatibility-matrix"
}
